+import os
+import sys
+
+import torch
+import torch.nn as nn
+
+TEST_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../.."))
+SRC_PATH = os.path.join(TEST_ROOT, "src", "python")
+if os.path.isdir(SRC_PATH) and SRC_PATH not in sys.path:
+    sys.path.append(SRC_PATH)
+
+from tlm.modeling import FrozenBaseWrapper
+from tlm.modeling.experts import ExpertRegistry, GatedExpertMixin
+
+
+class DummyExpert(nn.Module, GatedExpertMixin):
+    def __init__(self, in_features: int, out_features: int):
+        super().__init__()
+        self.linear = nn.Linear(in_features, out_features)
+
+    def forward(self, inputs: torch.Tensor):
+        return self.linear(inputs)
+
+    def gate_inputs(self, *args, **kwargs):
+        return "dummy"
+
+    def serialize(self):
+        return {"state": self.linear.state_dict(), "shape": tuple(self.linear.weight.shape)}
+
+    @classmethod
+    def deserialize(cls, state, in_features: int, out_features: int):
+        instance = cls(in_features=in_features, out_features=out_features)
+        instance.linear.load_state_dict(state["state"])
+        return instance
+
+
+def test_frozen_base_wrapper_freezes_parameters():
+    base = nn.Linear(4, 2)
+    sample_input = torch.randn(1, 4)
+    expected = base(sample_input)
+    wrapper = FrozenBaseWrapper(base)
+
+    assert all(not param.requires_grad for param in wrapper.base_model.parameters())
+
+    wrapped_output = wrapper(sample_input)
+    torch.testing.assert_close(wrapped_output, expected)
+
+
+def test_expert_registry_register_and_create():
+    registry = ExpertRegistry()
+    registry.register("dummy", DummyExpert)
+
+    expert = registry.create("dummy", in_features=4, out_features=2)
+    assert isinstance(expert, DummyExpert)
+    assert expert.gate_inputs() == "dummy"
+
+    state = expert.serialize()
+    restored = DummyExpert.deserialize(state, in_features=4, out_features=2)
+    torch.testing.assert_close(restored.linear.weight, expert.linear.weight)
+    torch.testing.assert_close(restored.linear.bias, expert.linear.bias)
 
